# --- Server ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Authorisation ---
# Phone numbers (with country code, no +, e.g. 919876543210) allowed to use the bot.
# Comma-separated. Anyone else is silently ignored.
ALLOWED_PHONES=919876543210

# Shared secret used to validate WAHA webhooks. Set the same value in WAHA's
# webhook config under "Webhook HMAC". Leave blank to disable HMAC check.
WAHA_WEBHOOK_HMAC_SECRET=

# --- WAHA (WhatsApp HTTP API) ---
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (transcription) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Anthropic (writer + intent router) ---
ANTHROPIC_API_KEY=

# Models. Defaults are sensible; override only if needed.
WRITER_MODEL=claude-sonnet-4-5-20250929
INTENT_MODEL=claude-haiku-4-5-20251001

# --- Session policy ---
# Auto-close an active session after this many hours of inactivity.
SESSION_TTL_HOURS=12
# Max messages kept in the sliding context window per session.
SESSION_WINDOW_SIZE=20
